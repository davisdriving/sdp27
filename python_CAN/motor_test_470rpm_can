/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USB_Device_Init();
  MX_FDCAN1_Init();
  /* USER CODE BEGIN 2 */
  HAL_GPIO_WritePin(CAN_STB_GPIO_Port,   CAN_STB_Pin,   GPIO_PIN_RESET); /* transceiver out of standby */
  HAL_GPIO_WritePin(CAN_RX_EN_GPIO_Port, CAN_RX_EN_Pin, GPIO_PIN_RESET); /* route transceiver RXD to PB8 */

  HAL_FDCAN_ConfigGlobalFilter(&hfdcan1, FDCAN_ACCEPT_IN_RX_FIFO0, FDCAN_ACCEPT_IN_RX_FIFO0,
                               FDCAN_REJECT_REMOTE, FDCAN_REJECT_REMOTE);
  if (HAL_FDCAN_Start(&hfdcan1) != HAL_OK)
  {
    Error_Handler();
  }

  HAL_Delay(3000);                               /* time to open screen */
  usb_print("CAN up, configuring motor\r\n");
  rs_stop();                         HAL_Delay(20);
  rs_write_u8(RS_RUN_MODE, 2);       HAL_Delay(20);  /* velocity mode */
  rs_enable();                       HAL_Delay(20);
  rs_write_float(RS_LIMIT_CUR, 2.0f); HAL_Delay(20); /* 2 A current limit */
  rs_write_float(RS_ACC_RAD, 20.0f); HAL_Delay(20);  /* ramps 0 -> 300 rpm in ~1.6 s */
  usb_print("motor enabled\r\n");
  uint32_t t0 = HAL_GetTick();
  char line[96];
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    /* 8 s at 300 rpm, then 4 s stopped, repeat */
    uint32_t phase = (HAL_GetTick() - t0) % 12000;
    float target = (phase < 8000) ? TARGET_RAD_S : 0.0f;
    rs_write_float(RS_SPD_REF, target);

    /* read motor replies (type 2 = feedback) */
    FDCAN_RxHeaderTypeDef rh;
    uint8_t rd[8];
    while (HAL_FDCAN_GetRxFifoFillLevel(&hfdcan1, FDCAN_RX_FIFO0) > 0)
    {
      if (HAL_FDCAN_GetRxMessage(&hfdcan1, FDCAN_RX_FIFO0, &rh, rd) != HAL_OK) break;
      if (((rh.Identifier >> 24) & 0x1F) == 2)
      {
        uint16_t raw = ((uint16_t)rd[2] << 8) | rd[3];
        int mrad_s = (int)(((float)raw - 32767.5f) * 50000.0f / 32767.5f);
        snprintf(line, sizeof line, "motor %lu: target %d rpm, speed %d rpm, fault 0x%02lX\r\n",
                 (unsigned long)((rh.Identifier >> 8) & 0xFF), (int)(target * 60.0f / 6.2832f),
                 (int)(mrad_s * 60 / 6283), (unsigned long)((rh.Identifier >> 16) & 0x3F));
        usb_print(line);
      }
    }

    /* report bus problems */
    FDCAN_ErrorCountersTypeDef ec;
    FDCAN_ProtocolStatusTypeDef ps;
    HAL_FDCAN_GetErrorCounters(&hfdcan1, &ec);
    HAL_FDCAN_GetProtocolStatus(&hfdcan1, &ps);
    if (ec.TxErrorCnt > 0 || ps.BusOff)
    {
      snprintf(line, sizeof line, "CAN errors: tx=%lu rx=%lu busoff=%lu\r\n",
               (unsigned long)ec.TxErrorCnt, (unsigned long)ec.RxErrorCnt, (unsigned long)ps.BusOff);
      usb_print(line);
    }

    HAL_Delay(100);
  }
  /* USER CODE END 3 */
}

